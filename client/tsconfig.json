{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "types": [
      "vitest/globals"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@api/*": [
        "./src/api/tauri/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@comtypes/*": [
        "./src/types/*"
      ],
    }
  },
  "include": [
    "src",
    "__tests__",
    "playwright.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}